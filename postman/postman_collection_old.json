              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_name\": \"\",\n      \"quantity\": -1,\n      \"unit_price\": \"invalid\"\n    }\n  ],\n  \"currency\": \"INVALID\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          },
