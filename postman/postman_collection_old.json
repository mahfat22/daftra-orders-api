        {
          "name": "Invalid Credit Card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": {{order_id}},\n  \"gateway\": \"stripe\",\n  \"amount\": \"100.00\",\n  \"currency\": \"USD\",\n  \"payment_method\": {\n    \"card_number\": \"1234567890123456\",\n    \"expiry_month\": \"13\",\n    \"expiry_year\": \"2020\",\n    \"cvv\": \"12345\",\n    \"cardholder_name\": \"\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments",
